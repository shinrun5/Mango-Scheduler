// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Store {
  id       Int                @id @default(autoincrement())
  name     String
  // false => opening is not a gated skill here; every employee at this store
  // counts as an opener regardless of their EmployeeStore.canOpen flag
  requiresOpenerSkill Boolean @default(true)
  shiftRequirement ShiftRequirement[]
  shifts    Shift[]
  employeeStores EmployeeStore[]
}

model ShiftRequirement {
  id              Int       @id @default(autoincrement())
  store           Store     @relation(fields: [storeId], references: [id])
  storeId         Int
  day             DayOfWeek
  start           DateTime
  end             DateTime
  managerRequired Int       @default(0)
  seniorRequired  Int       @default(0)
  regularRequired Int       @default(0)
  newRequired     Int       @default(0)
  // at least one assigned employee must be flagged canOpen
  needOpen        Boolean   @default(false)
  // availability may begin this many minutes after `start` and still count
  // (e.g. 60 for night shifts where a late arrival is fine)
  graceMinutes    Int       @default(0)
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Shift {
  id Int @id @default(autoincrement())
  employee Employee? @relation(fields: [employeeId], references: [id])
  employeeId Int?
  store Store @relation(fields: [storeId], references: [id])
  storeId Int
  day             DayOfWeek
  start           DateTime
  end             DateTime
}

model Employee {
  id Int @id @default(autoincrement())
  name String
  shift Shift[]
  hourLimit Int
  maxShifts Int @default(6)   // max distinct days worked per week
  standby Boolean @default(false)   // on-call: never auto-scheduled, only manually assignable
  employeeStores EmployeeStore[]
  recurringAvailability RecurringAvailability[]
  // account link: an Employee starts with no login; a manager issues an
  // inviteCode, the person registers with it, and a User row gets linked here
  user       User?
  inviteCode String?  @unique
}

enum Role {
  MANAGER
  EMPLOYEE
}

// Our own identity row. `authId` is the only reference to Supabase Auth --
// every app relation hangs off User.id so the auth provider can be swapped
// without re-modelling anything.
model User {
  id         Int      @id @default(autoincrement())
  authId     String   @unique   // Supabase auth.users.id (UUID)
  email      String   @unique
  role       Role     @default(EMPLOYEE)
  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId Int?      @unique
  createdAt  DateTime @default(now())
}

model RecurringAvailability {
  id         Int       @id @default(autoincrement())
  employee   Employee  @relation(fields: [employeeId], references: [id])
  employeeId Int
  day        DayOfWeek
  start      DateTime
  end        DateTime
}
enum Experience {
  NEW
  REGULAR
  SENIOR
  MANAGER
}

model EmployeeStore {
  employee       Employee @relation(fields: [employeeId], references: [id])
  employeeId     Int
  store          Store    @relation(fields: [storeId], references: [id])
  storeId        Int
  pin       String
  proficiency Experience
  canOpen   Boolean  @default(false)   // trusted to open the store (not tier-derived)
  primary   Boolean  @default(true)    // false = the solver only sends them here to close a gap

  @@id([employeeId, storeId])
  @@unique([storeId, pin])
}
